# =====================================================================
# JOB HUNTER AI — VARIABLES DE ENTORNO (.env.example)
# =====================================================================
# Copia este archivo a `.env` y completa los valores con tus credenciales:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. BASE DE DATOS
# ---------------------------------------------------------------------
# Para desarrollo local rápido, SQLite funciona inmediatamente sin instalar nada:
DATABASE_URL=sqlite:///./data/jobhunter.db
# Para producción (ej. PostgreSQL en Railway, Supabase o Neon):
# DATABASE_URL=postgresql://usuario:password@host:5432/basedatos

# ---------------------------------------------------------------------
# 2. SEGURIDAD, GATEKEEPER WAF Y PANEL DE ADMINISTRACIÓN
# ---------------------------------------------------------------------
# Clave secreta para firmar tokens JWT (genera una cadena aleatoria de al menos 32 caracteres)
JWT_SECRET_KEY=AQUI_TU_JWT_SECRET_SUPER_SEGURO_DE_32_CARACTERES

# Credenciales de acceso al Panel Privado (/gatekeeper-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AQUI_TU_CONTRASENA_SEGURA_2026!
ADMIN_SECRET_PATH=gatekeeper-admin

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# 3. INTELIGENCIA ARTIFICIAL — MOTOR B (EVALUACIÓN Y PITCH DE VACANTES)
# ---------------------------------------------------------------------
# Proveedor por defecto: Google Gemini (Recomendado: 100% GRATIS)
# Consigue tu API Key gratuita en: https://aistudio.google.com/
AI_PROVIDER=gemini
GEMINI_API_KEY=AQUI_TU_GEMINI_API_KEY_DE_GOOGLE_AI_STUDIO
AI_MODEL=gemini-2.0-flash

# Proveedor alternativo (Opcional: Si prefieres OpenAI, Groq u OpenRouter):
# AI_PROVIDER=openai
# AI_API_KEY=AQUI_TU_API_KEY_DE_OPENAI_O_GROQ
# AI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------
# 4. SCRAPING Y ENRUTADOR DE COSTES (APIFY — OPCIONAL)
# ---------------------------------------------------------------------
# Si lo dejas vacío, el bot funciona al 100% con scrapers Nivel 0 gratuitos ($0.00).
# Si deseas scraping profundo en LinkedIn o proxies cloud, obtén tu token gratis en https://apify.com/
APIFY_API_TOKEN=AQUI_TU_APIFY_API_TOKEN_OPCIONAL
MAX_SEARCH_BUDGET_USD=2.00

# ---------------------------------------------------------------------
# 5. FRONTEND (NEXT.JS)
# ---------------------------------------------------------------------
# URL donde corre el backend de FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
